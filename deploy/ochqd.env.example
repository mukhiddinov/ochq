# /etc/ochq/ochqd.env — ochqd settings, read by systemd.
# After editing: sudo systemctl restart ochqd

OCHQD_TUNNEL_ADDR=:9000
OCHQD_HTTP_ADDR=:8080

# Base domain. Until the real domain is ready, nip.io gives free wildcard
# DNS for any IP: demo.203.0.113.10.nip.io resolves to 203.0.113.10.
# Replace 203.0.113.10 with your VPS IP.
OCHQD_DOMAIN=203.0.113.10.nip.io
OCHQD_PUBLIC_SCHEME=http
OCHQD_PUBLIC_PORT=8080

# If set, clients must pass the same value with --token / $OCHQ_TOKEN.
# Generate one with: openssl rand -hex 32
OCHQD_TOKEN=
