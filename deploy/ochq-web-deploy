#!/usr/bin/env bash
# Installs a new ochq-web release. Runs as root via sudo, and is the ONLY
# command the CI deploy key may run (see authorized_keys forced command):
#
#   ssh ochq_web_deploy@vps <version> < ochq-web
#
# Layout:
#   /opt/ochq-web/releases/<version>/ochq-web
#   /opt/ochq-web/current -> releases/<version>   (switched atomically)
set -euo pipefail
umask 022

BASE=/opt/ochq-web
KEEP=5
MAX_BYTES=$((100 * 1024 * 1024))

log() { echo "ochq-web-deploy: $*" >&2; }

VERSION="${1:-}"
if [[ ! "$VERSION" =~ ^[A-Za-z0-9._-]{1,64}$ ]]; then
    log "usage: ochq-web-deploy <version> < ochq-web   (version: [A-Za-z0-9._-], max 64)"
    exit 2
fi

RELEASES="$BASE/releases"
REL="$RELEASES/$VERSION"

# 1. Receive the binary from stdin into a temp dir next to the releases,
#    so the final mv is an atomic rename on the same filesystem.
TMP=$(mktemp -d "$RELEASES/.incoming.XXXXXX")
trap 'rm -rf "$TMP"' EXIT
chmod 0755 "$TMP"
head -c "$MAX_BYTES" > "$TMP/ochq-web"
chmod 0755 "$TMP/ochq-web"

# 2. Validate. The ELF check matters: exec of a non-binary fails with ENOEXEC
#    and runuser then runs the file as a shell script, so an empty upload
#    would "succeed" the smoke test below.
if [[ "$(head -c 4 "$TMP/ochq-web")" != $'\x7fELF' ]]; then
    log "upload is not a Linux executable (empty or truncated?)"
    exit 1
fi
# Smoke test as the unprivileged service user, never as root.
if ! got=$(runuser -u ochq_web -- "$TMP/ochq-web" -version 2>&1) || [[ "$got" != ochq-web\ * ]]; then
    log "uploaded binary does not run: $got"
    exit 1
fi
log "received $got"

rm -rf "$REL"
mv "$TMP" "$REL"

# 3. Switch the symlink atomically and restart.
# Empty on the first deploy: readlink -f would happily return the path of a
# missing link, and rolling back to it would make current point to itself.
PREV=""
if [[ -L "$BASE/current" ]]; then
    PREV=$(readlink -f "$BASE/current")
fi
ln -sfn "$REL" "$BASE/current.new"
mv -T "$BASE/current.new" "$BASE/current"
systemctl restart ochq-web

# 4. Health check; roll back if the new release does not stay up.
# ochq-web must also answer: a bad listen address or env file keeps the
# unit "activating" in a restart loop instead of failing outright.
healthy() {
    local addr
    addr=$(sed -n 's/^OCHQ_WEB_ADDR=//p' /etc/ochq/ochq-web.env | tail -n 1)
    for _ in 1 2 3 4 5; do
        sleep 2
        systemctl is-active --quiet ochq-web &&
            curl -fsS --max-time 2 "http://${addr:-127.0.0.1:8090}/healthz" >/dev/null && return 0
    done
    return 1
}
if ! healthy; then
    log "ochq-web failed to start; last logs:"
    journalctl -u ochq-web -n 20 --no-pager >&2 || true
    if [[ -n "$PREV" && -d "$PREV" && "$PREV" != "$REL" ]]; then
        log "rolling back to $PREV"
        ln -sfn "$PREV" "$BASE/current.new"
        mv -T "$BASE/current.new" "$BASE/current"
        systemctl restart ochq-web
    else
        # Nothing to go back to: stop instead of crash-looping.
        log "no previous release; stopping ochq-web"
        systemctl stop ochq-web
        rm -f "$BASE/current"
        rm -rf "$REL"
    fi
    exit 1
fi
log "deployed $VERSION"

# 5. Keep only the newest $KEEP releases (never the active one).
CUR=$(readlink -f "$BASE/current")
find "$RELEASES" -mindepth 1 -maxdepth 1 -type d ! -name '.incoming.*' -printf '%T@ %p\n' |
    sort -rn | tail -n +$((KEEP + 1)) | cut -d' ' -f2- |
    while read -r old; do
        [[ "$old" == "$CUR" ]] || rm -rf -- "$old"
    done
