# /etc/ochq/ochq-web.env — ochq-web settings, read by systemd.
# After editing: sudo systemctl restart ochq-web

# The gateway of Docker's "edge" network: Traefik reaches it, the internet
# does not. Check with: docker network inspect edge -f '{{(index .IPAM.Config 0).Gateway}}'
OCHQ_WEB_ADDR=172.30.0.128:8090

# Traefik's address on the edge network: only it may set X-Forwarded-For.
OCHQ_WEB_TRUSTED_PROXY=172.30.0.2

# Makes stored visitor-address hashes useless elsewhere. Keep it secret and
# never change it (rate limits and moderation rely on stable hashes).
# Generate: openssl rand -hex 32
OCHQ_WEB_SALT=
